# ==============================================================================
# XERO KHAN — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Public Brand: XERO KHAN | Internal Project: xero-khan-bot
# Never commit real credentials, tokens, or private keys.
# ==============================================================================

# Server & Runtime
NODE_ENV=development
PORT=3000

# Security & Data Protection (Authenticated AES-256-GCM)
# Must decode to exactly 32 bytes (unambiguous 64 hexadecimal characters):
# Generate with: openssl rand -hex 32
DELIVERY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
DELIVERY_ENCRYPTION_KEY_VERSION=v1

# PostgreSQL (Authoritative Database)
DATABASE_URL=postgresql://postgres:password@localhost:5432/xero_khan_bot

# Redis (Non-authoritative Cache, FSM & Rate Limiting)
REDIS_URL=redis://localhost:6379

# Telegram Bot API
TELEGRAM_BOT_TOKEN=123456789:ABCDEF_mock_telegram_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.railway.app/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_min_32_chars
TELEGRAM_ADMIN_IDS=123456789,987654321

# AiToolShop Reseller API v1
AITOOLSHOP_BASE_URL=https://aitoolshop.aitoolifystudio.io/api/reseller/v1
AITOOLSHOP_RESELLER_API_KEY=mock_aitoolshop_reseller_api_key

# Binance Pay Integration
BINANCE_PAY_ENABLED=false
BINANCE_API_BASE_URL=https://bpay.binanceapi.com
BINANCE_API_KEY=mock_binance_api_key_placeholder
BINANCE_API_SECRET=mock_binance_api_secret_placeholder
BINANCE_RECEIVER_ID=mock_binance_receiver_uid
BINANCE_RECV_WINDOW_MS=5000
BINANCE_REQUEST_TIMEOUT_MS=10000
BINANCE_MIN_DEPOSIT_USDT=0.10
BINANCE_MAX_DEPOSIT_USDT=10000.00
BINANCE_DIAGNOSTIC_ENABLED=false

# Operational Safety Flags
RECOVERY_MODE=true
LIVE_ORDERING_ENABLED=false
MANUAL_PAYMENTS_ENABLED=true
